# Copy to `.env` and adjust. All variables are optional but recommended.

# Absolute site URL — used for RSS / sitemap / Open Graph URLs.
NUXT_PUBLIC_SITE_URL=https://jizhangji.github.io

# Only needed when the site is NOT served from the domain root.
#   GitHub Pages user site → /; project site → /<repo>/ (workflow sets this)
#   Custom domain / Cloudflare Pages / Vercel → leave unset (i.e. "/")
# NUXT_APP_BASE_URL=/zhangji-blog/
